diff --git a/src/os/android/setup_android.cpp b/src/os/android/setup_android.cpp
new file mode 100644
index 0000000..85d21fb
--- /dev/null
+++ b/src/os/android/setup_android.cpp
@@ -0,0 +1,284 @@
+/*
+ * Android platform glue: storage base path, logcat+file tee, setup check,
+ * and JNI diagnostics for Dod3Activity.
+ */
+#include <android/log.h>
+#include <dlfcn.h>
+#include <jni.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <vulkan/vulkan.h>
+
+#include <SDL2/SDL.h>
+
+#include <filesystem>
+#include <mutex>
+#include <string>
+#include <system_error>
+#include <thread>
+#include <vector>
+
+#ifndef DOD3_ANDROID_RUNTIME_SMOKE
+#include "install/install.h"
+#include "ui/ui.h"
+#endif
+
+#define LOGI(...) __android_log_print(ANDROID_LOG_INFO, "Dod3Android", __VA_ARGS__)
+#define LOGE(...) __android_log_print(ANDROID_LOG_ERROR, "Dod3Android", __VA_ARGS__)
+
+namespace {
+
+std::mutex s_mu;
+std::string s_base_dir;
+bool s_log_started = false;
+
+std::string resolve_base_dir()
+{
+    std::lock_guard<std::mutex> g(s_mu);
+    if (!s_base_dir.empty()) return s_base_dir;
+    if (const char* env = getenv("DOD3_INSTALL_BASE"); env && *env) {
+        s_base_dir = env;
+        return s_base_dir;
+    }
+    if (const char* ext = SDL_AndroidGetExternalStoragePath(); ext && *ext) {
+        s_base_dir = ext;
+        return s_base_dir;
+    }
+    if (const char* intl = SDL_AndroidGetInternalStoragePath(); intl && *intl) {
+        s_base_dir = intl;
+        return s_base_dir;
+    }
+    s_base_dir = "/storage/emulated/0/Dod3Recomp";
+    return s_base_dir;
+}
+
+bool has_ext(const std::vector<VkExtensionProperties>& exts, const char* name)
+{
+    for (const auto& e : exts)
+        if (strcmp(e.extensionName, name) == 0) return true;
+    return false;
+}
+
+std::string probe_vulkan()
+{
+    void* lib = dlopen("libvulkan.so", RTLD_NOW | RTLD_LOCAL);
+    if (!lib) return "Vulkan: GAGAL memuat libvulkan.so (" + std::string(dlerror() ? dlerror() : "?") + ")";
+
+    auto get_inst_proc = (PFN_vkGetInstanceProcAddr)dlsym(lib, "vkGetInstanceProcAddr");
+    if (!get_inst_proc) {
+        dlclose(lib);
+        return "Vulkan: vkGetInstanceProcAddr tidak ditemukan";
+    }
+    auto enum_inst_ver = (PFN_vkEnumerateInstanceVersion)get_inst_proc(VK_NULL_HANDLE, "vkEnumerateInstanceVersion");
+    auto create_inst = (PFN_vkCreateInstance)get_inst_proc(VK_NULL_HANDLE, "vkCreateInstance");
+    if (!create_inst) {
+        dlclose(lib);
+        return "Vulkan: vkCreateInstance tidak ditemukan";
+    }
+
+    uint32_t loader_ver = VK_API_VERSION_1_0;
+    if (enum_inst_ver) enum_inst_ver(&loader_ver);
+    uint32_t req_ver = loader_ver >= VK_API_VERSION_1_3 ? VK_API_VERSION_1_3
+                     : loader_ver >= VK_API_VERSION_1_2 ? VK_API_VERSION_1_2 : VK_API_VERSION_1_1;
+
+    VkApplicationInfo app = {};
+    app.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO;
+    app.pApplicationName = "Dod3Recomp";
+    app.pEngineName = "ps3recomp";
+    app.apiVersion = req_ver;
+
+    VkInstanceCreateInfo ici = {};
+    ici.sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO;
+    ici.pApplicationInfo = &app;
+
+    VkInstance inst = VK_NULL_HANDLE;
+    VkResult vr = create_inst(&ici, nullptr, &inst);
+    if (vr != VK_SUCCESS) {
+        dlclose(lib);
+        return "Vulkan: vkCreateInstance gagal (" + std::to_string((int)vr) + ")";
+    }
+
+    auto destroy_inst = (PFN_vkDestroyInstance)get_inst_proc(inst, "vkDestroyInstance");
+    auto enum_phys = (PFN_vkEnumeratePhysicalDevices)get_inst_proc(inst, "vkEnumeratePhysicalDevices");
+    auto get_props = (PFN_vkGetPhysicalDeviceProperties)get_inst_proc(inst, "vkGetPhysicalDeviceProperties");
+    auto get_feat2 = (PFN_vkGetPhysicalDeviceFeatures2)get_inst_proc(inst, "vkGetPhysicalDeviceFeatures2");
+    auto get_fmt = (PFN_vkGetPhysicalDeviceFormatProperties)get_inst_proc(inst, "vkGetPhysicalDeviceFormatProperties");
+    auto enum_dev_ext = (PFN_vkEnumerateDeviceExtensionProperties)get_inst_proc(inst, "vkEnumerateDeviceExtensionProperties");
+
+    uint32_t nd = 0;
+    enum_phys(inst, &nd, nullptr);
+    std::string out = "Vulkan Loader: " + std::to_string(VK_API_VERSION_MAJOR(loader_ver)) + "." +
+                      std::to_string(VK_API_VERSION_MINOR(loader_ver)) + "." +
+                      std::to_string(VK_API_VERSION_PATCH(loader_ver));
+    if (nd > 0) {
+        std::vector<VkPhysicalDevice> devs(nd);
+        enum_phys(inst, &nd, devs.data());
+        VkPhysicalDeviceProperties props = {};
+        get_props(devs[0], &props);
+        out += "\nGPU: " + std::string(props.deviceName) + " (Vulkan " +
+               std::to_string(VK_API_VERSION_MAJOR(props.apiVersion)) + "." +
+               std::to_string(VK_API_VERSION_MINOR(props.apiVersion)) + "." +
+               std::to_string(VK_API_VERSION_PATCH(props.apiVersion)) + ")";
+
+        uint32_t ne = 0;
+        enum_dev_ext(devs[0], nullptr, &ne, nullptr);
+        std::vector<VkExtensionProperties> exts(ne);
+        if (ne) enum_dev_ext(devs[0], nullptr, &ne, exts.data());
+
+        VkPhysicalDeviceFeatures2 f2 = {};
+        f2.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2;
+        if (get_feat2) get_feat2(devs[0], &f2);
+
+        VkFormatProperties d32 = {}, d24 = {};
+        get_fmt(devs[0], VK_FORMAT_D32_SFLOAT_S8_UINT, &d32);
+        get_fmt(devs[0], VK_FORMAT_D24_UNORM_S8_UINT, &d24);
+        const bool ok_d32 = (d32.optimalTilingFeatures & VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT) != 0;
+        const bool ok_d24 = (d24.optimalTilingFeatures & VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT) != 0;
+
+        out += "\nCaps: BCn=" + std::string(f2.features.textureCompressionBC ? "YA" : "TIDAK") +
+               " | D32S8=" + std::string(ok_d32 ? "YA" : "TIDAK") +
+               " | D24S8=" + std::string(ok_d24 ? "YA" : "TIDAK") +
+               " | KHR_dyn_render=" + std::string(has_ext(exts, "VK_KHR_dynamic_rendering") ? "YA" : "TIDAK") +
+               " | KHR_timeline=" + std::string(has_ext(exts, "VK_KHR_timeline_semaphore") ? "YA" : "TIDAK");
+    } else {
+        out += "\nGPU: Tidak ada physical device ditemukan";
+    }
+    if (destroy_inst) destroy_inst(inst, nullptr);
+    dlclose(lib);
+    return out;
+}
+
+}  // namespace
+
+extern "C" const char* dod3_android_exe_dir(void)
+{
+    static std::string dir;
+    dir = resolve_base_dir();
+    return dir.c_str();
+}
+
+extern "C" const char* dod3_android_data_dir(void)
+{
+    static std::string dir;
+    dir = resolve_base_dir();
+    std::error_code ec;
+    std::filesystem::create_directories(std::filesystem::path(dir), ec);
+    return dir.c_str();
+}
+
+extern "C" void dod3_android_log_to_file(void)
+{
+    std::lock_guard<std::mutex> g(s_mu);
+    if (s_log_started) return;
+    s_log_started = true;
+
+    rename("dod3.log", "dod3.prev.log");
+    FILE* f = fopen("dod3.log", "w");
+
+    int pfd[2];
+    if (pipe(pfd) != 0) {
+        if (f) fclose(f);
+        return;
+    }
+    dup2(pfd[1], STDOUT_FILENO);
+    dup2(pfd[1], STDERR_FILENO);
+    if (pfd[1] > 2) close(pfd[1]);
+    setvbuf(stdout, nullptr, _IOLBF, 0);
+    setvbuf(stderr, nullptr, _IOLBF, 0);
+
+    std::thread([fd = pfd[0], f]() {
+        pthread_setname_np(pthread_self(), "dod3_log_tee");
+        char buf[4096];
+        std::string line;
+        for (;;) {
+            const ssize_t n = read(fd, buf, sizeof buf);
+            if (n <= 0) break;
+            if (f) {
+                fwrite(buf, 1, (size_t)n, f);
+                fflush(f);
+            }
+            for (ssize_t i = 0; i < n; i++) {
+                if (buf[i] == '\n') {
+                    if (!line.empty()) {
+                        __android_log_write(ANDROID_LOG_INFO, "Dod3Android", line.c_str());
+                        line.clear();
+                    }
+                } else {
+                    line += buf[i];
+                    if (line.size() >= 1000) {
+                        __android_log_write(ANDROID_LOG_INFO, "Dod3Android", line.c_str());
+                        line.clear();
+                    }
+                }
+            }
+        }
+        if (!line.empty()) __android_log_write(ANDROID_LOG_INFO, "Dod3Android", line.c_str());
+        close(fd);
+        if (f) fclose(f);
+    }).detach();
+}
+
+extern "C" int dod3_setup_android(const char* base_dir, int force)
+{
+#ifdef DOD3_ANDROID_RUNTIME_SMOKE
+    (void)base_dir;
+    (void)force;
+    return 0;
+#else
+    using namespace dod3setup;
+    const fs::path base(base_dir);
+    if (!installed(base).ready() || force) {
+        LOGI("Game files belum lengkap di %s (menunggu user via launcher/wizard)", base_dir);
+        const int r = run_installer(base);
+        if (r >= 0) return r;
+        LOGE("Installer SDL/ImGui gagal dibuka; letakkan game/disc dan elf/EBOOT_101.ELF di %s", base_dir);
+        return 1;
+    }
+    return 0;
+#endif
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_com_dod3recomp_android_Dod3Activity_nativeSetBaseDir(JNIEnv* env, jclass, jstring path)
+{
+    if (!path) return;
+    const char* s = env->GetStringUTFChars(path, nullptr);
+    if (!s) return;
+    {
+        std::lock_guard<std::mutex> g(s_mu);
+        s_base_dir = s;
+    }
+    setenv("DOD3_INSTALL_BASE", s, 1);
+    LOGI("Base dir diset via JNI: %s", s);
+    env->ReleaseStringUTFChars(path, s);
+}
+
+extern "C" JNIEXPORT jstring JNICALL
+Java_com_dod3recomp_android_Dod3Activity_nativeRunDiagnostics(JNIEnv* env, jclass)
+{
+    namespace fs = std::filesystem;
+    const std::string base = resolve_base_dir();
+    const long pg = sysconf(_SC_PAGESIZE);
+    std::error_code ec;
+    const bool has_sfo = fs::exists(fs::path(base) / "game/disc/PS3_GAME/PARAM.SFO", ec);
+    const bool has_elf = fs::exists(fs::path(base) / "elf/EBOOT_101.ELF", ec);
+
+    std::string report =
+#ifdef DOD3_ANDROID_RUNTIME_SMOKE
+        "Mode Build: RUNTIME SMOKE (bring-up Vulkan/SDL2 tanpa lifted game code)\n"
+#else
+        "Mode Build: FULL STANDALONE (lifted PPU/SPU + ps3recomp)\n"
+#endif
+        "ABI: arm64-v8a | Host Page Size: " + std::to_string(pg) + " bytes\n" +
+        probe_vulkan() + "\n" +
+        "Folder Data: " + base + "\n" +
+        "PARAM.SFO: " + std::string(has_sfo ? "ADA" : "BELUM ADA") +
+        " | EBOOT_101.ELF: " + std::string(has_elf ? "ADA" : "BELUM ADA");
+
+    LOGI("Diagnostics:\n%s", report.c_str());
+    return env->NewStringUTF(report.c_str());
+}
diff --git a/src/os/android/smoke_main.cpp b/src/os/android/smoke_main.cpp
new file mode 100644
