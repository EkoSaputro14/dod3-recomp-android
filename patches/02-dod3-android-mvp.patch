--- /dev/null
+++ b/src/os/android/smoke_main.cpp
@@ -0,0 +1,50 @@
+/*
+ * Day-1 Android runtime smoke entrypoint (DOD3_ANDROID_RUNTIME_SMOKE=1).
+ * Verifies SDL2 + Vulkan 1.1-1.3 draw engine + glslang SPIR-V init on device
+ * without requiring lifted game C++ files.
+ */
+#include <android/log.h>
+#include <SDL2/SDL.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+#include "rsx_shader_spirv.h"
+#include "rsx_vulkan_engine.h"
+
+extern "C" {
+const char* dod3_android_data_dir(void);
+void dod3_android_log_to_file(void);
+}
+
+#define LOGI(...) __android_log_print(ANDROID_LOG_INFO, "Dod3Android", __VA_ARGS__)
+#define LOGE(...) __android_log_print(ANDROID_LOG_ERROR, "Dod3Android", __VA_ARGS__)
+
+int main(int argc, char** argv)
+{
+    (void)argc;
+    (void)argv;
+
+    const char* data = dod3_android_data_dir();
+    if (data && *data) chdir(data);
+    dod3_android_log_to_file();
+
+    LOGI("=== Dod3Recomp Android Runtime Smoke Start (data=%s) ===", data ? data : "(null)");
+    LOGI("glslang SPIR-V available: %d", rsx_hlsl_to_spirv_available());
+
+    if (rsx_vulkan_engine_init(1280, 720, "Drakengard 3 Recompiled (Smoke)") != 0) {
+        LOGE("rsx_vulkan_engine_init FAILED");
+        SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, "Dod3Recomp Smoke",
+                                 "Vulkan init failed. Check adb logcat -s Dod3Android.", nullptr);
+        return 1;
+    }
+
+    LOGI("rsx_vulkan_engine_init OK — entering event pump loop");
+    while (rsx_vulkan_engine_pump_messages() == 0) {
+        SDL_Delay(16);
+    }
+
+    rsx_vulkan_engine_shutdown();
+    LOGI("=== Dod3Recomp Android Runtime Smoke Clean Exit ===");
+    return 0;
+}
diff --git a/src/ui/ui_android.cpp b/src/ui/ui_android.cpp
new file mode 100644
index 0000000..2022731
--- /dev/null
+++ b/src/ui/ui_android.cpp
@@ -0,0 +1,137 @@
+/*
+ * Android Dear ImGui window layer (src/ui/ui.h): SDL2 fullscreen + SDL_Renderer2.
+ * File picking on Android is handled via Storage Access Framework in Dod3Activity.
+ */
+#include "ui/ui.h"
+
+#include "imgui.h"
+#include "backends/imgui_impl_sdl2.h"
+#include "backends/imgui_impl_sdlrenderer2.h"
+
+#include <SDL2/SDL.h>
+#include <stdio.h>
+
+namespace dod3setup {
+namespace {
+
+struct Ui {
+    SDL_Window* window = nullptr;
+    SDL_Renderer* renderer = nullptr;
+    bool live = false;
+    bool closed = false;
+};
+Ui s_ui;
+
+}  // namespace
+
+bool ui_init(const char* title, int width, int height, const std::string& font_path, float font_px)
+{
+    (void)width;
+    (void)height;
+    if (SDL_InitSubSystem(SDL_INIT_VIDEO | SDL_INIT_GAMECONTROLLER | SDL_INIT_EVENTS) != 0) {
+        fprintf(stderr, "[setup] SDL: %s\n", SDL_GetError());
+        return false;
+    }
+    s_ui.window = SDL_CreateWindow(title ? title : "Drakengard 3 Recompiled", SDL_WINDOWPOS_UNDEFINED,
+                                   SDL_WINDOWPOS_UNDEFINED, 0, 0,
+                                   SDL_WINDOW_FULLSCREEN | SDL_WINDOW_ALLOW_HIGHDPI);
+    if (!s_ui.window) {
+        fprintf(stderr, "[setup] SDL_CreateWindow: %s\n", SDL_GetError());
+        return false;
+    }
+    /* Prefer software renderer during setup wizard so EGL/GLES never attaches to Android's ANativeWindow before Vulkan init. */
+    s_ui.renderer = SDL_CreateRenderer(s_ui.window, -1, SDL_RENDERER_SOFTWARE);
+    if (!s_ui.renderer) s_ui.renderer = SDL_CreateRenderer(s_ui.window, -1, SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC);
+    if (!s_ui.renderer) {
+        SDL_DestroyWindow(s_ui.window);
+        s_ui = Ui{};
+        return false;
+    }
+
+    IMGUI_CHECKVERSION();
+    ImGui::CreateContext();
+    ImGuiIO& io = ImGui::GetIO();
+    io.IniFilename = nullptr;
+    io.LogFilename = nullptr;
+    io.ConfigFlags |= ImGuiConfigFlags_NavEnableKeyboard | ImGuiConfigFlags_NavEnableGamepad;
+    if (!ImGui_ImplSDL2_InitForSDLRenderer(s_ui.window, s_ui.renderer) || !ImGui_ImplSDLRenderer2_Init(s_ui.renderer)) {
+        ImGui::DestroyContext();
+        SDL_DestroyRenderer(s_ui.renderer);
+        SDL_DestroyWindow(s_ui.window);
+        s_ui = Ui{};
+        return false;
+    }
+    if (!font_path.empty() && !io.Fonts->AddFontFromFileTTF(font_path.c_str(), font_px))
+        fprintf(stderr, "[setup] could not load font %s\n", font_path.c_str());
+    if (io.Fonts->Fonts.empty()) io.Fonts->AddFontDefault();
+    ImGui::GetStyle().FontSizeBase = font_px;
+    s_ui.live = true;
+    s_ui.closed = false;
+    return true;
+}
+
+bool ui_frame_begin()
+{
+    for (;;) {
+        SDL_Event e;
+        while (SDL_PollEvent(&e)) {
+            ImGui_ImplSDL2_ProcessEvent(&e);
+            if (e.type == SDL_QUIT) s_ui.closed = true;
+            if (e.type == SDL_WINDOWEVENT && e.window.event == SDL_WINDOWEVENT_CLOSE &&
+                e.window.windowID == SDL_GetWindowID(s_ui.window))
+                s_ui.closed = true;
+        }
+        if (!s_ui.live || s_ui.closed) return false;
+        if (SDL_GetWindowFlags(s_ui.window) & SDL_WINDOW_MINIMIZED) {
+            SDL_WaitEventTimeout(nullptr, 50);
+            continue;
+        }
+        break;
+    }
+    ImGui_ImplSDLRenderer2_NewFrame();
+    ImGui_ImplSDL2_NewFrame();
+    ImGui::NewFrame();
+    return true;
+}
+
+void ui_frame_end()
+{
+    ImGui::Render();
+    ImGuiIO& io = ImGui::GetIO();
+    SDL_RenderSetScale(s_ui.renderer, io.DisplayFramebufferScale.x, io.DisplayFramebufferScale.y);
+    SDL_SetRenderDrawColor(s_ui.renderer, 0, 0, 0, 255);
+    SDL_RenderClear(s_ui.renderer);
+    ImGui_ImplSDLRenderer2_RenderDrawData(ImGui::GetDrawData(), s_ui.renderer);
+    SDL_RenderPresent(s_ui.renderer);
+}
+
+void ui_shutdown()
+{
+    if (!s_ui.live) return;
+    ImGui_ImplSDLRenderer2_Shutdown();
+    ImGui_ImplSDL2_Shutdown();
+    ImGui::DestroyContext();
+    SDL_DestroyRenderer(s_ui.renderer);
+    SDL_DestroyWindow(s_ui.window);
+    SDL_PumpEvents();
+    SDL_QuitSubSystem(SDL_INIT_VIDEO | SDL_INIT_GAMECONTROLLER | SDL_INIT_EVENTS);
+    s_ui = Ui{};
+}
+
+std::vector<std::filesystem::path> ui_pick_files(const char* title,
+                                                 const std::vector<std::pair<std::string, std::string>>& filters)
+{
+    (void)title;
+    (void)filters;
+    fprintf(stderr, "[setup] Android uses Storage Access Framework in Dod3Activity to import ISO/PKG files.\n");
+    return {};
+}
+
+std::filesystem::path ui_pick_folder(const char* title)
+{
+    (void)title;
+    fprintf(stderr, "[setup] Android uses /storage/emulated/0/Dod3Recomp or SAF import.\n");
+    return {};
+}
+
+}  // namespace dod3setup
