     void*   host_stack;
@@ -99,7 +109,7 @@ struct Sched {
     int     running;             /* a thread is inside RunFibers */
 #ifdef _WIN32
     void*   back;                /* RunFibers' fiber while it runs one */
-#else
+#elif !defined(__ANDROID__)
     ucontext_t back;             /* RunFibers' context while it runs one */
 #endif
 };
@@ -201,6 +211,88 @@ static void host_yield(Fiber* f)
 {
     SwitchToFiber(f->sched->back);
 }
+#elif defined(__ANDROID__)
+static void* fiber_entry(void* p)
+{
+    Fiber* f = (Fiber*)p;
+    pthread_mutex_lock(&f->step_mu);
+    while (f->turn == 0 && !f->exit_flag)
+        pthread_cond_wait(&f->step_cv, &f->step_mu);
+    const int abort_now = f->exit_flag;
+    pthread_mutex_unlock(&f->step_mu);
+    if (abort_now) return NULL;
+    t_cur = f;
+    g_active_ctx = &f->ctx;
+    fiber_body(f);
+    return NULL;
+}
+
+static int host_create(Fiber* f)
+{
+    if (pthread_mutex_init(&f->step_mu, NULL) != 0) return 0;
+    if (pthread_cond_init(&f->step_cv, NULL) != 0) {
+        pthread_mutex_destroy(&f->step_mu);
+        return 0;
+    }
+    f->turn = 0;
+    f->exit_flag = 0;
+    f->thread_started = 0;
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, FIBER_HOST_STACK);
+    int rc = pthread_create(&f->host_thread, &attr, fiber_entry, f);
+    pthread_attr_destroy(&attr);
+    if (rc != 0) rc = pthread_create(&f->host_thread, NULL, fiber_entry, f);
+    if (rc != 0) {
+        pthread_cond_destroy(&f->step_cv);
+        pthread_mutex_destroy(&f->step_mu);
+        return 0;
+    }
+    f->thread_started = 1;
+    return 1;
+}
+
+/* Signals any suspended fiber thread to exit cleanly, joins it, and releases sync primitives. */
+static void host_destroy(Fiber* f)
+{
+    if (!f->thread_started) return;
+    pthread_mutex_lock(&f->step_mu);
+    f->exit_flag = 1;
+    f->turn = 1;
+    pthread_cond_broadcast(&f->step_cv);
+    pthread_mutex_unlock(&f->step_mu);
+    pthread_join(f->host_thread, NULL);
+    f->thread_started = 0;
+    pthread_cond_destroy(&f->step_cv);
+    pthread_mutex_destroy(&f->step_mu);
+}
+
+static void host_resume(Sched* s, Fiber* f)
+{
+    (void)s;
+    pthread_mutex_lock(&f->step_mu);
+    f->turn = 1;
+    pthread_cond_signal(&f->step_cv);
+    while (f->turn == 1 && !f->exit_flag)
+        pthread_cond_wait(&f->step_cv, &f->step_mu);
+    pthread_mutex_unlock(&f->step_mu);
+}
+
+static void host_yield(Fiber* f)
+{
+    pthread_mutex_lock(&f->step_mu);
+    f->turn = 0;
+    pthread_cond_signal(&f->step_cv);
+    while (f->turn == 0 && !f->exit_flag)
+        pthread_cond_wait(&f->step_cv, &f->step_mu);
+    const int abort_now = f->exit_flag;
+    pthread_mutex_unlock(&f->step_mu);
+    if (abort_now) {
+        g_active_ctx = NULL;
+        t_cur = NULL;
+        pthread_exit(NULL);
+    }
+}
 #else
 static void fiber_entry(unsigned hi, unsigned lo)
 {
@@ -252,6 +344,15 @@ static void fiber_leave(Fiber* f)
 {
 #ifdef _WIN32
     SwitchToFiber(f->sched->back);
+#elif defined(__ANDROID__)
+    pthread_mutex_lock(&f->step_mu);
+    f->exit_flag = 1;
+    f->turn = 0;
+    pthread_cond_signal(&f->step_cv);
+    pthread_mutex_unlock(&f->step_mu);
+    g_active_ctx = NULL;
+    t_cur = NULL;
+    pthread_exit(NULL);
 #else
     setcontext(&f->sched->back);
 #endif
