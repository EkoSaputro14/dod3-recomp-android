+static VkFramebuffer vk_get_framebuffer(VkRenderPass rp, u32 w, u32 h, u32 natt, const VkImageView* views)
+{
+    for (u32 i = 0; i < s_fb_count; i++) {
+        const EngFbEntry* e = &s_fb_cache[i];
+        if (e->rp != rp || e->w != w || e->h != h || e->natt != natt) continue;
+        if (memcmp(e->views, views, natt * sizeof(VkImageView)) == 0) return e->fb;
+    }
+    if (s_fb_count >= FB_CACHE_MAX) {
+        /* Evicted framebuffer may still be referenced by in-flight command buffers. */
+        if (s_dev) vkDeviceWaitIdle(s_dev);
+        vkDestroyFramebuffer(s_dev, s_fb_cache[0].fb, NULL);
+        memmove(&s_fb_cache[0], &s_fb_cache[1], (s_fb_count - 1) * sizeof(EngFbEntry));
+        s_fb_count--;
+    }
+    VkFramebufferCreateInfo fci = { VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO };
+    fci.renderPass = rp;
+    fci.attachmentCount = natt;
+    fci.pAttachments = views;
+    fci.width = w;
+    fci.height = h;
+    fci.layers = 1;
+    VkFramebuffer fb = VK_NULL_HANDLE;
+    if (vkCreateFramebuffer(s_dev, &fci, NULL, &fb) != VK_SUCCESS) return VK_NULL_HANDLE;
+    EngFbEntry* e = &s_fb_cache[s_fb_count++];
+    memset(e, 0, sizeof *e);
+    e->rp = rp; e->w = w; e->h = h; e->natt = natt;
+    memcpy(e->views, views, natt * sizeof(VkImageView));
+    e->fb = fb;
+    return fb;
+}
+
+static void vk_invalidate_view_fb(VkImageView view)
+{
+    if (!view) return;
+    u32 dst = 0;
+    for (u32 i = 0; i < s_fb_count; i++) {
+        int hit = 0;
+        for (u32 k = 0; k < s_fb_cache[i].natt; k++) {
+            if (s_fb_cache[i].views[k] == view) { hit = 1; break; }
+        }
+        if (hit) {
+            if (s_fb_cache[i].fb) vkDestroyFramebuffer(s_dev, s_fb_cache[i].fb, NULL);
+        } else {
+            if (dst != i) s_fb_cache[dst] = s_fb_cache[i];
+            dst++;
+        }
+    }
+    s_fb_count = dst;
+}
+
+static void vk_clear_rp_fb_cache(void)
+{
+    for (u32 i = 0; i < s_fb_count; i++) if (s_fb_cache[i].fb) vkDestroyFramebuffer(s_dev, s_fb_cache[i].fb, NULL);
+    s_fb_count = 0;
+    for (u32 i = 0; i < s_rp_count; i++) if (s_rp_cache[i].rp) vkDestroyRenderPass(s_dev, s_rp_cache[i].rp, NULL);
+    s_rp_count = 0;
+}
