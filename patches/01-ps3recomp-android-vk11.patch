+static void bc_decode_color(const u8* b, int four_color, u8 pal[4][4])
+{
+    const u16 c0 = (u16)b[0] | ((u16)b[1] << 8);
+    const u16 c1 = (u16)b[2] | ((u16)b[3] << 8);
+    const u32 r0 = ((c0 >> 11) & 0x1Fu), g0 = ((c0 >> 5) & 0x3Fu), b0 = (c0 & 0x1Fu);
+    const u32 r1 = ((c1 >> 11) & 0x1Fu), g1 = ((c1 >> 5) & 0x3Fu), b1 = (c1 & 0x1Fu);
+    pal[0][0] = (u8)((r0 << 3) | (r0 >> 2));
+    pal[0][1] = (u8)((g0 << 2) | (g0 >> 4));
+    pal[0][2] = (u8)((b0 << 3) | (b0 >> 2));
+    pal[0][3] = 255;
+    pal[1][0] = (u8)((r1 << 3) | (r1 >> 2));
+    pal[1][1] = (u8)((g1 << 2) | (g1 >> 4));
+    pal[1][2] = (u8)((b1 << 3) | (b1 >> 2));
+    pal[1][3] = 255;
+    if (four_color || c0 > c1) {
+        pal[2][0] = (u8)((2u * pal[0][0] + pal[1][0]) / 3u);
+        pal[2][1] = (u8)((2u * pal[0][1] + pal[1][1]) / 3u);
+        pal[2][2] = (u8)((2u * pal[0][2] + pal[1][2]) / 3u);
+        pal[2][3] = 255;
+        pal[3][0] = (u8)((pal[0][0] + 2u * pal[1][0]) / 3u);
+        pal[3][1] = (u8)((pal[0][1] + 2u * pal[1][1]) / 3u);
+        pal[3][2] = (u8)((pal[0][2] + 2u * pal[1][2]) / 3u);
+        pal[3][3] = 255;
+    } else {
+        pal[2][0] = (u8)((pal[0][0] + pal[1][0]) / 2u);
+        pal[2][1] = (u8)((pal[0][1] + pal[1][1]) / 2u);
+        pal[2][2] = (u8)((pal[0][2] + pal[1][2]) / 2u);
+        pal[2][3] = 255;
+        pal[3][0] = pal[3][1] = pal[3][2] = pal[3][3] = 0;
+    }
+}
