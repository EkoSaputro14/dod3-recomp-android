+    const u32 bx_max = row_bytes / blk_bytes;
+    const u32 nbx = bx_n < bx_max ? bx_n : bx_max;
+    const u32 nby = by_n < rows ? by_n : rows;
+    for (u32 by = 0; by < nby; by++) {
+        for (u32 bx = 0; bx < nbx; bx++) {
+            const u8* blk = src + (size_t)by * row_bytes + (size_t)bx * blk_bytes;
+            const u8* cblk = (bc_fmt == RSX_BE_FMT_BC1) ? blk : (blk + 8);
+            u8 pal[4][4];
+            bc_decode_color(cblk, bc_fmt != RSX_BE_FMT_BC1, pal);
+            const u32 cidx = (u32)cblk[4] | ((u32)cblk[5] << 8) | ((u32)cblk[6] << 16) | ((u32)cblk[7] << 24);
+            u8 aa[8];
